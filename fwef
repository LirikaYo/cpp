#include <iostream>
#include <locale>
#include <string> 
#include <cmath>

template<typename example>
void vvod(example& x, std::string s) {
	std::cout << s;
	std::cin >> x;
}

template<typename example>
void vivod(example& x, std::string s) {
	std::cout << s << x << std::endl;
}

class triangle {
private:
	float a = 0, b = 0, c = 0;
public:
	triangle() {
		vvod(a, "Введите сторону a: ");
		vvod(b, "Введите сторону b: ");
		vvod(c, "Введите сторону c: ");
		prover();
		std::cout << "Объект создан." << std::endl;
	}

	triangle(float stor_a, float stor_b, float stor_c) {
		a = stor_a;
		b = stor_b;
		c = stor_c;
		prover();
	}

	void prover() {
		if ((a <= 0) || (b <= 0) || (c <= 0)) {
			throw "Вы ввели не правильные числа.";
		}
		if ((a + b <= c) || (a + c <= b) || (c + b <= a)) {
			throw "Треугольник не может быть создан.";
		}
	}

	float Area() const {
		float p = (a + b + c) / 2;
		float S = sqrt(p * (p - a) * (p - b) * (p - c));
		return S;
	}

	std::string strochka() const {
		return std::to_string(a) + " " + std::to_string(b) + " " + std::to_string(c);
	}

static triangle triang_from_strok(std::string str) {
	int len = str.length();

	// --- 1. ПРОВЕРКА КОЛИЧЕСТВА ЭЛЕМЕНТОВ В САМОМ НАЧАЛЕ ---
	int spaces = 0;
	int check_i = 0;

	// Считаем пробелы обычным индексом int
	while (check_i < len) {
		if (str[check_i] == ' ') {
			spaces++;
		}
		check_i++;
	}

	// Если пробелов не 2 (чисел вошло не 3) — сразу жесткий стоп
	if (spaces != 2) {
		throw "Ошибка: В строке должно быть ровно 3 элемента!";
	}

	// --- 2. ДАЛЬШЕ ВЫПОЛНЯЕМ НАШИ ДЕЙСТВИЯ (Разрезаем строку через int индексы) ---
	int pos1 = -1;
	int pos2 = -1;
	int i = 0;

	// Находим точные координаты первого и второго пробела
	while (i < len) {
		if (str[i] == ' ') {
			if (pos1 == -1) {
				pos1 = i; // Нашли первый пробел
			}
			else if (pos2 == -1) {
				pos2 = i; // Нашли второй пробел
				break;    // Оба пробела найдены, дальше цикл крутить не нужно
			}
		}
		i++;
	}

	// Вырезаем куски текста, зная их точные int-координаты
	std::string s1 = str.substr(0, pos1);               // От начала до 1-го пробела
	std::string s2 = str.substr(pos1 + 1, pos2 - pos1 - 1); // Между 1-м и 2-м пробелом
	std::string s3 = str.substr(pos2 + 1);               // От 2-го пробела до конца строки

	// Переводим текст в нормальные float числа
	float sa = std::stof(s1);
	float sb = std::stof(s2);
	float sc = std::stof(s3);

	// Возвращаем готовый треугольник
	return triangle(sa, sb, sc);
}


	void print() {
		vivod(a, "Размер a: ");
		vivod(b, "Размер b: ");
		vivod(c, "Размер c: ");
	}

	~triangle() {
		std::cout << "Объект был удален." << std::endl;
	}
};

int main() {
	setlocale(LC_ALL, "RU");

	try {
		triangle t;
		float area = t.Area();
		vivod(area, "Площадь S: ");
		t.print();

		std::string stor_triang = t.strochka();
		std::cout << "Треугольник в виде строки: " << stor_triang << std::endl;

		triangle t2 = triangle::triang_from_strok(stor_triang);
		std::cout << "Второй треугольник из строки. " << std::endl;
		t2.print();
	}
	catch (const char* msg) {
		std::cout << msg << std::endl;
	}

	return 0;
}
